# ========================================================
# CẤU HÌNH API KEY (Chọn 1 trong 3 nhà cung cấp bên dưới)
# ========================================================

# 1. GOOGLE GEMINI (KHUYÊN DÙNG - 100% MIỄN PHÍ)
# Lấy key miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_groq_api_key_here

# 2. GROQ (100% MIỄN PHÍ - TỐC ĐỘ SIÊU NHANH)
# Lấy key miễn phí tại: https://console.groq.com/keys
# GROQ_API_KEY=gsk_...

# 3. OPENAI (Cần nạp thẻ tín dụng $5+)
# Lấy key tại: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# ========================================================
# CẤU HÌNH MẠNG NỘI BỘ (Khi chạy nhiều máy cùng lúc)
# ========================================================
# Nếu Frontend và Backend chạy trên cùng 1 máy → để mặc định (127.0.0.1)
# Nếu máy khác muốn kết nối vào Backend → đổi thành IP thực của máy chủ
# Ví dụ: BACKEND_HOST=192.168.1.10
BACKEND_HOST=127.0.0.1
